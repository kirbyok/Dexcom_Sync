# Dexcom Configuration
DEXCOM_EMAIL=your_dexcom_email@example.com
# Or use phone number instead
DEXCOM_PHONE=+12125551234
DEXCOM_PASSWORD=your_dexcom_password
# Set to 'true' if using international Dexcom server
DEXCOM_USE_INTL=false
DEXCOM_DEVICE_NAME=Dexcom

# Nightscout Configuration (optional)
NIGHTSCOUT_URL=https://your-nightscout-site.herokuapp.com
NIGHTSCOUT_API_TOKEN=your_nightscout_api_token

# Tandem Diabetes tconnectsync Configuration (for pump data)
TCONNECT_USERNAME=your_tconnect_email@example.com
TCONNECT_PASSWORD=your_tconnect_password
# Set to 'true' to enable Tandem pump data sync
TCONNECT_SYNC_ENABLED=false
TCONNECT_DEVICE_NAME=Tandem

# Tandem feature toggles (all default to true)
# Set to false to disable specific pump data categories
TCONNECT_FEATURE_BASAL=true
TCONNECT_FEATURE_BOLUS=true
TCONNECT_FEATURE_PUMP_EVENTS=true
TCONNECT_FEATURE_PROFILES=true

# Sync interval in minutes (default: 3 minutes)
SYNC_INTERVAL_MINUTES=3

# Timezone for all timestamps (default: UTC)
TIMEZONE=UTC
