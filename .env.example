# Dexcom Configuration
DEXCOM_EMAIL=your_dexcom_email@example.com
# Or use phone number instead
DEXCOM_PHONE=+12125551234
DEXCOM_PASSWORD=your_dexcom_password
# Set to 'true' if using international Dexcom server
DEXCOM_USE_INTL=false

# Nightscout Configuration (optional)
NIGHTSCOUT_URL=https://your-nightscout-site.herokuapp.com
NIGHTSCOUT_API_TOKEN=your_nightscout_api_token

# Sync interval in minutes (default: 3 minutes)
SYNC_INTERVAL_MINUTES=3
